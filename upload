#!/usr/bin/env bash
csd="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
[[ "$csd" == *.app/Contents/Resources ]] && csd="$(dirname "$(dirname "$(dirname "$csd")")")"
cd "$csd"

REPO_NAME="dockerapp"
GITHUB_USER="superkeyor"
DOCKERHUB_USER="superkeyor"
REPO_VISIBILITY="--public"

# ── Per-project overrides ─────────────────────────────────────────────────────
RUN_GIT=true      # true/false: git add + commit (+ push to GitHub if not local)

RUN_DOCKER=false   # true/false: docker hub build + push
DOCKER_CHOICE=""  # ""=ask, "1"=native, "2"=buildx multi-platform, "3"=skip

RUN_REMOTE=false  # true/false: rsync + remote docker build
SSH_LOGIN=""      # e.g. 'ssh -p 2023 parallels@192.168.1.81'
# ─────────────────────────────────────────────────────────────────────────────

# ── 0. Secrets: .env must be 600 (rsync -a carries this to the remote) ──────
if [[ -f .env && "$(stat -c %a .env 2>/dev/null || stat -f %Lp .env)" != "600" ]]; then
    echo "Fixing .env permission to 600."
    chmod 600 .env
fi

# ── 1. Git: commit (+ push to GitHub if not local) ───────────────────────────
if [[ "$RUN_GIT" == false ]]; then
    echo "Skipping git commit and push (not enabled)."
else
    git add -A
    git commit -m 'update'
    if [[ "$REPO_VISIBILITY" == "--local" ]]; then
        echo "Local mode: skipping git push (no remote)."
    else
        git push git@github.com:${GITHUB_USER}/${REPO_NAME}.git
    fi
fi

# ── 2. Docker Hub: build + push ───────────────────────────────────────────────
if [[ "$RUN_DOCKER" == false ]]; then
    echo "Skipping Docker Hub push (not enabled)."
elif [[ $(command -v docker) != "" ]]; then
    if [[ "${REPO_VISIBILITY}" == "--private" ]]; then
        echo "Repo is private. Skipping Docker Hub push."
    else
        if [[ -z "$DOCKER_CHOICE" ]]; then
            echo "Push to Docker Hub ${DOCKERHUB_USER}/${REPO_NAME}:latest?"
            echo "  1) Yes, native platform"
            echo "  2) Yes, multi-platform (linux/amd64,linux/arm64) via buildx"
            echo "  3) No, skip"
            read -p "Choice [1]: " DOCKER_CHOICE
        fi
        DOCKER_CHOICE=${DOCKER_CHOICE:-1}

        DATE_TAG=$(date +%Y%m%d)
        if [[ "$DOCKER_CHOICE" == "1" ]]; then
            echo "Building and pushing native platform image..."
            sudo docker build                 --tag ${DOCKERHUB_USER}/${REPO_NAME}:latest                 --tag ${DOCKERHUB_USER}/${REPO_NAME}:${DATE_TAG}                 .
            sudo docker image push ${DOCKERHUB_USER}/${REPO_NAME}:latest
            sudo docker image push ${DOCKERHUB_USER}/${REPO_NAME}:${DATE_TAG}
        elif [[ "$DOCKER_CHOICE" == "2" ]]; then
            echo "Building and pushing multi-platform image..."
            sudo docker buildx build                 --platform linux/amd64,linux/arm64                 --tag ${DOCKERHUB_USER}/${REPO_NAME}:latest                 --tag ${DOCKERHUB_USER}/${REPO_NAME}:${DATE_TAG}                 --push                 .
        else
            echo "Skipping Docker Hub push (user choice)."
        fi
    fi
fi

# ── 3. Remote SSH: rsync + build ─────────────────────────────────────────────
if [[ "$RUN_REMOTE" == false ]]; then
    echo "Skipping remote build (not enabled)."
elif [[ -z "$SSH_LOGIN" ]]; then
    echo "Skipping remote build (SSH_LOGIN not set)."
else
    echo "Building remotely via $SSH_LOGIN..."
    port=$(echo "$SSH_LOGIN" | cut -d' ' -f3)
    user=$(echo "$SSH_LOGIN" | cut -d' ' -f4 | cut -d'@' -f1)
    host=$(echo "$SSH_LOGIN" | cut -d' ' -f4 | cut -d'@' -f2)
    folder=/home/$user/App/$REPO_NAME
    compose=/data/caddy/docker-compose.yml

    # Ensure rsync is available on remote
    ssh -p $port $user@$host "command -v rsync >/dev/null 2>&1 || { echo 'Installing rsync...'; sudo apt-get install -y rsync; }"

    # Sync files
    ssh -p $port $user@$host "mkdir -p $folder"
    rsync -e "ssh -p $port" . $user@$host:$folder/         -avz --delete         --exclude='.git/'         --exclude='__pycache__/'         --exclude='.DS_Store'         --exclude='._*'
        # -avz: archive, verbose, compress

    # Include this app's compose file in the server compose file (needs mikefarah yq)
    # Runs before down/up, so any failure aborts without touching containers
    # Idempotent: edits only if not yet included; backup + validation before replacing
    ssh -p $port $user@$host bash -s -- "$folder" "$compose" <<'EOF' || { echo "Include step failed. Aborting before touching containers."; exit 1; }
folder=$1
compose=$2
tmp="$compose.new"
trap 'sudo rm -f "$tmp"' EXIT

# Auto-detect the absolute app path (resolves symlinks)
app_compose="$(cd "$folder" && pwd -P)/docker-compose.yml"

yq --version 2>&1 | grep -q mikefarah || { echo "ERROR: mikefarah yq not found on server"; exit 1; }
[ -f "$app_compose" ] || { echo "ERROR: $app_compose not found"; exit 1; }
[ -f "$compose" ] || { echo "ERROR: $compose not found"; exit 1; }

# Already included? (entry may be a plain path or a map with "path")
found=$(sudo env P="$app_compose" yq '(.include // []) | map(select((tag == "!!str" and . == strenv(P)) or (tag == "!!map" and .path == strenv(P)))) | length' "$compose") || exit 1
if [ "$found" -gt 0 ]; then
    echo "Already included: $app_compose"
    exit 0
fi

# A service defined in both files is silently won by the server file (shadows the included one)
for svc in $(yq '.services | keys | .[]' "$app_compose"); do
    dup=$(sudo env S="$svc" yq '(.services // {}) | has(strenv(S))' "$compose") || exit 1
    [ "$dup" = true ] && { echo "ERROR: service '$svc' is already defined in $compose; remove it there first"; exit 1; }
done

# Edit a copy next to the original (same folder, so relative paths still resolve), validate, then swap
sudo cp -p "$compose" "$compose.bak"
sudo cp -p "$compose" "$tmp"
sudo env P="$app_compose" yq -i -I 4 '.include = (.include // []) + [strenv(P)]' "$tmp" || exit 1
sudo docker compose -f "$tmp" config -q || { echo "ERROR: merged compose file is invalid; $compose unchanged"; exit 1; }
sudo mv "$tmp" "$compose"
echo "Added include: $app_compose (backup: $compose.bak)"
EOF

    # Build on remote
    # -t: allocate a pseudo-terminal
    ssh -p $port $user@$host -t "
    cd $folder && \
    sudo docker compose -f $compose down && \
    sudo docker build --progress=plain --tag ${REPO_NAME}:latest $folder && \
    sudo docker compose -f $compose up -d && \
    sudo docker system prune --force
"

    # Local git tracking of remote deploy
    git add -A
    git commit -m 'remote deploy'
fi
    
echo ""
echo "Visit (if available) https://github.com/${GITHUB_USER}/${REPO_NAME}"
echo "                     https://hub.docker.com/r/${DOCKERHUB_USER}/${REPO_NAME}/tags"
echo ""
